# Exemplo: use a conta Gmail que enviará os pedidos para ela mesma.
GMAIL_ADDRESS=exemplo.usuario@gmail.com
GMAIL_APP_PASSWORD=

# Crie a senha em https://myaccount.google.com/apppasswords (é necessário
# ativar a verificação em duas etapas). Cole a senha de app de 16 caracteres,
# não a senha normal do Google. Consulte o README para o passo a passo.

# Se o Codex CLI não estiver no PATH, informe aqui o caminho completo do binário.
CODEX_BIN=codex

# Socket Unix local do Docker, liberado somente para o agente desenvolvedor.
# Linux padrão: /var/run/docker.sock. Deixe vazio se o agente não deve usar Docker.
CODEX_DOCKER_SOCKET=/var/run/docker.sock

# Usados apenas no deploy do formulário web em produção para proteger a rota
# com autenticação Basic do Nginx. Use uma senha aleatória longa, diferente da
# senha Gmail. Nunca publique estes valores no Git.
DEMANDAS_WEB_USER=gustavo
DEMANDAS_WEB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA_LONGA
